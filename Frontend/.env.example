# Server-only URL used by the same-origin /api/backend proxy.
# In Docker Compose this is http://backend:8000. On Vercel, set it to the
# public HTTPS URL of the Azure-hosted FastAPI service.
BACKEND_API_URL=http://127.0.0.1:8000

# Optional escape hatch for direct browser-to-API requests. Leave this unset
# for production so authentication stays first-party through /api/backend.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com
