# Copy this file to .env and replace every placeholder locally.
# Never commit Backend/.env or real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_COOKIE_NAME=magictrip_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
API_RATE_LIMIT_PER_MINUTE=180
AUTH_RATE_LIMIT_PER_MINUTE=10
PLANNING_WORKER_POLL_SECONDS=1.5
PROVIDER_CACHE_ENABLED=true
PROVIDER_CACHE_DEFAULT_TTL_SECONDS=3600

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ORS_API_KEY=
OPENWEATHER_API_KEY=

# Server-side only. Never expose this key as NEXT_PUBLIC_*.
GOOGLE_API_KEY=
GOOGLE_WEATHER_ENABLED=false

# Keep these false while the frontend displays Leaflet/OpenStreetMap. Google
# Places results shown on a map must use a Google map.
GOOGLE_PLACES_ENABLED=false
GOOGLE_ROUTES_ENABLED=false
GOOGLE_GEOCODING_ENABLED=false

# Conservative hard application limits, all below the published free caps.
GOOGLE_WEATHER_MONTHLY_LIMIT=3000
GOOGLE_PLACES_SEARCH_MONTHLY_LIMIT=1500
GOOGLE_PLACES_DETAILS_MONTHLY_LIMIT=400
GOOGLE_ROUTES_MONTHLY_LIMIT=2500
GOOGLE_GEOCODING_MONTHLY_LIMIT=3000
